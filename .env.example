# ==============================================================================
# FinNews AI - Environment Variables
# Copy this file to .env and replace placeholders with your actual API keys.
# ==============================================================================

# NewsAPI Key: Required for live financial news fetching
# Register free at: https://newsapi.org/
NEWS_API_KEY=your_newsapi_key_here

# Groq API Key: Required for ultra-fast Llama 3.3 70B summarization
# Obtain free at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Identifier (Default: Llama 3.3 70B Versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
DEFAULT_PAGE_SIZE=6

# Allowed CORS Origins (comma-separated for dev and production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173,*
